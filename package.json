{
  "name": "askuity-qa-automation",
  "version": "1.0.0",
  "description": "WebdriverIO + TypeScript end-to-end suite for the Morrow Supply shopping-cart exercise (Askuity QA Automation take-home).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.desktop.conf.ts",
    "test:desktop": "wdio run ./config/wdio.desktop.conf.ts",
    "test:mobile": "wdio run ./config/wdio.mobile.conf.ts",
    "test:browserstack": "wdio run ./config/wdio.browserstack.conf.ts",
    "test:all": "npm run test:desktop; desktop=$?; npm run test:mobile; mobile=$?; exit $((desktop || mobile))",
    "test:stable": "wdio run ./config/wdio.desktop.conf.ts --mochaOpts.grep @known-bug --mochaOpts.invert",
    "test:bugs": "wdio run ./config/wdio.desktop.conf.ts --mochaOpts.grep @known-bug",
    "test:smoke": "wdio run ./config/wdio.desktop.conf.ts --mochaOpts.grep @smoke",
    "wdio": "wdio run ./config/wdio.desktop.conf.ts",
    "report": "allure generate ./reports/allure-results/* -o ./reports/allure-report --clean && allure open ./reports/allure-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rm -rf reports"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/browserstack-service": "^9.40.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/logger": "^9.29.1",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure": "^3.21.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-wdio": "^9.31.3",
    "expect-webdriverio": "^6.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "webdriverio": "^9.32.0"
  }
}
