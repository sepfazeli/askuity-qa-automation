# Copy to .env to override defaults. Every value is optional.

# Application under test
BASE_URL=https://qa-task--oyettijon.replit.app

# chrome (default) or firefox. Desktop suite only; the mobile suite always uses Chrome.
BROWSER=chrome

# Run without a visible browser window (defaults to true when CI=true)
HEADLESS=false

# Parallel workers (one spec file per worker)
MAX_INSTANCES=4

# Mocha retries per test. Keep 0 locally so flakiness is visible, not hidden.
MOCHA_RETRIES=0

# Framework log level written to reports/logs: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Shared practice password (public on the login page); override instead of editing code
STORE_PASSWORD=test_sauce

# Optional: run the mobile tests on real devices (npm run test:browserstack).
# Find these at https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
